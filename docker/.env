# Docker Images
AUTH_SERVICE_IMAGE=authorization-sv:1.0.0
LOAN_REQUEST_IMAGE=loan-request-sv:1.0.0

# Service Ports
AUTH_SERVICE_PORT=8080
LOAN_REQUEST_PORT=8081

# MySQL Configuration for Authentication Service
MYSQL_DB_HOST=authorization-mysql-db
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=authenticacion_db
MYSQL_USER=authuser
MYSQL_PASSWORD=authpassword
MYSQL_PORT=3306

# PostgreSQL Configuration for Loan Request Service
POSTGRESQL_DB_HOST=loan-request-postgresql-db
POSTGRES_DB=loan_request_db
POSTGRES_USER=loanuser
POSTGRES_PASSWORD=loanpassword
POSTGRES_PORT=5432

# JWT Configuration for Authentication Service
JWT_SECRET=bXlTZWNyZXRLZXkxMjM0NTY3ODkwMTIzNDU2Nzg5MDEyMzQ1Njc4OTA=
JWT_EXPIRATION=3600

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
